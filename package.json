{
  "name": "yuhan-codex-session-tabs",
  "displayName": "Codex Session Tabs",
  "description": "Open and organize official Codex chats in editor tabs.",
  "version": "0.5.0",
  "publisher": "youngunghan",
  "repository": { "type": "git", "url": "https://github.com/youngunghan/codex-session-tabs.git" },
  "license": "MIT",
  "engines": { "vscode": "^1.96.2" },
  "categories": ["Other", "Chat"],
  "keywords": ["codex", "tabs", "chat", "sessions"],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished", "onView:codexSessionTabs.sessions", "onCommand:codexSessionTabs.newTab"],
  "contributes": {
    "configuration": {
      "title": "Codex Session Tabs",
      "properties": {
        "codexSessionTabs.replaceNewTabOnHistoryOpen": {
          "type": "boolean",
          "default": true,
          "description": "Replace the active tab created by Codex Session Tabs with saved conversations selected inside its Codex history. The official editor opens a history tab, which this extension pins and uses to replace only that managed tab. The replaced tab and unsent input may be lost. Set false to keep both tabs."
        }
      }
    },
    "commands": [
      { "command": "codexSessionTabs.newTab", "title": "Codex: New Codex Tab", "icon": "$(sparkle-filled)" },
      { "command": "codexSessionTabs.focusTab", "title": "Codex Sessions: Focus Tab" },
      { "command": "codexSessionTabs.renameTab", "title": "Codex Sessions: Rename List Label", "icon": "$(edit)" },
      { "command": "codexSessionTabs.reopenSession", "title": "Codex Sessions: Reopen Conversation", "icon": "$(history)" }
    ],
    "views": {
      "explorer": [{ "id": "codexSessionTabs.sessions", "name": "Codex Sessions" }]
    },
    "menus": {
      "editor/title": [{ "command": "codexSessionTabs.newTab", "group": "navigation@1" }],
      "view/title": [{ "command": "codexSessionTabs.newTab", "when": "view == codexSessionTabs.sessions", "group": "navigation@1" }],
      "view/item/context": [
        { "command": "codexSessionTabs.renameTab", "when": "view == codexSessionTabs.sessions && viewItem == codexOpenTab", "group": "inline@1" },
        { "command": "codexSessionTabs.renameTab", "when": "view == codexSessionTabs.sessions && viewItem == codexRecentSession", "group": "inline@1" },
        { "command": "codexSessionTabs.reopenSession", "when": "view == codexSessionTabs.sessions && viewItem == codexRecentSession", "group": "inline@2" },
        { "command": "codexSessionTabs.renameTab", "when": "view == codexSessionTabs.sessions && viewItem == codexOpenTab", "group": "1_modify@1" },
        { "command": "codexSessionTabs.renameTab", "when": "view == codexSessionTabs.sessions && viewItem == codexRecentSession", "group": "1_modify@1" },
        { "command": "codexSessionTabs.reopenSession", "when": "view == codexSessionTabs.sessions && viewItem == codexRecentSession", "group": "1_modify@2" }
      ]
    },
    "keybindings": [{
      "command": "codexSessionTabs.newTab",
      "key": "ctrl+alt+n",
      "mac": "ctrl+alt+n"
    }]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/runVsCode.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0"
  }
}
