{
  "name": "yuhan-codex-session-tabs",
  "displayName": "Codex Session Tabs",
  "description": "Open multiple editor tabs with the original official Codex interface.",
  "version": "0.6.1",
  "publisher": "youngunghan",
  "repository": {
    "type": "git",
    "url": "https://github.com/youngunghan/codex-session-tabs.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "keywords": [
    "codex",
    "tabs",
    "chat",
    "sessions"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexSessionTabs.newTab",
    "onWebviewPanel:codexSessionTabs.chat"
  ],
  "contributes": {
    "configuration": {
      "title": "Codex Session Tabs",
      "properties": {
        "codexSessionTabs.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Python 3.11\u20133.13 executable used to create the private Codex SDK environment on first setup. Empty uses python3 (python on Windows)."
        }
      }
    },
    "commands": [
      {
        "command": "codexSessionTabs.newTab",
        "title": "Codex: New Codex Tab",
        "icon": {
          "light": "icons/codex-light.svg",
          "dark": "icons/codex-dark.svg"
        }
      },
      {
        "command": "codexSessionTabs.newSdkTab",
        "title": "Codex: New SDK Chat Tab"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codexSessionTabs.newTab",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexSessionTabs.newTab",
        "key": "ctrl+alt+n",
        "mac": "ctrl+alt+n"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/runVsCode.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0"
  }
}
