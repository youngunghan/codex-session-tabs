{
  "name": "yuhan-codex-session-tabs",
  "displayName": "Codex Session Tabs",
  "description": "Open the official Codex chat in multiple independent editor tabs.",
  "version": "0.2.4",
  "publisher": "youngunghan",
  "repository": { "type": "git", "url": "https://github.com/youngunghan/codex-session-tabs.git" },
  "license": "MIT",
  "engines": { "vscode": "^1.96.2" },
  "categories": ["Other", "Chat"],
  "keywords": ["codex", "tabs", "chat", "sessions"],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "extensionDependencies": ["openai.chatgpt"],
  "activationEvents": ["onStartupFinished", "onCommand:codexSessionTabs.newTab"],
  "contributes": {
    "commands": [{
      "command": "codexSessionTabs.newTab",
      "title": "Codex: New Codex Tab",
      "icon": "$(add)"
    }],
    "keybindings": [{
      "command": "codexSessionTabs.newTab",
      "key": "ctrl+alt+n",
      "mac": "ctrl+alt+n"
    }]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/runVsCode.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0"
  }
}
